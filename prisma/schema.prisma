// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Card {
  id        String   @id @default(uuid())
  name      String
  team      String
  price     Float
  grade     String
  year      Int
  createdAt DateTime @default(now())

  images     CardImage[]
  featuredIn HomeContent[]
}

model CardImage {
  id     String  @id @default(uuid())
  url    String
  isHero Boolean @default(false)

  cardId String
  card   Card   @relation(fields: [cardId], references: [id])
}

model Order {
  id        String   @id @default(uuid())
  total     Float
  status    String // PENDING, PAID
  createdAt DateTime @default(now())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
}

model Customer {
  id    String @id @default(uuid())
  name  String
  email String

  orders Order[]
}

model HomeContent {
  id          String   @id @default(uuid())
  title       String
  subtitle    String
  description String
  price       Float
  featuredId  String? // relation to Card
  createdAt   DateTime @default(now())

  featured Card? @relation(fields: [featuredId], references: [id])
}
