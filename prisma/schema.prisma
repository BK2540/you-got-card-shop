generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum CardStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  PAID
  IN_DELIVERY
  COMPLETED
  FAILED
  CANCELED
}

model Card {
  id            String     @id @default(uuid())
  name          String
  playerName    String
  team          String
  price         Float
  grade         String
  year          Int
  quantity      Int        @default(0)
  isRecommended Boolean    @default(false)
  description   String     @default("")
  status        CardStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now()) @updatedAt

  images     CardImage[]
  featuredIn HomeContent[]
  orderItems OrderItem[]

  @@index([status])
  @@index([createdAt])
  @@index([name])
  @@index([playerName])
  @@index([isRecommended])
}

model CardImage {
  id        String   @id @default(uuid())
  url       String
  publicId  String?
  isHero    Boolean  @default(false)
  createdAt DateTime @default(now())

  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([publicId])
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  orders Order[]

  @@index([name])
}

model HomeContent {
  id          String   @id @default(uuid())
  title       String
  subtitle    String
  description String
  price       Float
  featuredId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  featured Card? @relation(fields: [featuredId], references: [id])

  @@index([featuredId])
}

model Order {
  id              String      @id @default(uuid())
  total           Float
  status          OrderStatus @default(PENDING)
  trackingNumber  String?
  stripeSessionId String?     @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @default(now()) @updatedAt

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  items OrderItem[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(uuid())
  quantity  Int
  unitPrice Float
  createdAt DateTime @default(now())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([cardId])
}
